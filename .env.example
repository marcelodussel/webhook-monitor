# Next.js (public — safe to expose in the browser)
NEXT_PUBLIC_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
NEXT_PUBLIC_INGEST_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/hooks

# AWS (local CLI / deploy; do not commit real secrets)
AWS_REGION=us-east-1

# App API (Day 2+ read API; placeholder for portfolio)
APP_API_KEY=replace-me-with-a-long-random-string

# Optional (Day 3+ AI explain in app API Lambda; do not commit real secrets)
# Google AI Studio API key → same value as SAM parameter GeminiApiKey
GEMINI_API_KEY=

# Local / overrides when running the Lambda outside SAM (normally set by the template):
# GEMINI_MODEL=gemini-2.0-flash
# AI_USAGE_TABLE=whm-dev-ai-usage
# AI_EXPLAIN_MAX_PER_DAY=100
